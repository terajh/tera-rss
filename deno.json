{
  "tasks": {
    "collect": "deno run --allow-net --allow-read --allow-write src/collect.ts",
    "merge": "deno run --allow-read --allow-write src/merge.ts",
    "update": "deno task collect && deno task merge",
    "collect:economy": "deno run --allow-net --allow-read --allow-write src/collect.ts economy",
    "merge:economy": "deno run --allow-read --allow-write src/merge.ts economy",
    "collect:dev": "deno run --allow-net --allow-read --allow-write src/collect.ts dev",
    "merge:dev": "deno run --allow-read --allow-write src/merge.ts dev",
    "classify": "deno run --allow-net --allow-read --allow-write src/classify.ts",
    "classify:dev": "deno run --allow-net --allow-read --allow-write src/classify.ts dev",
    "split": "deno run --allow-read --allow-write src/split.ts",
    "test": "deno test --allow-read src/tests/"
  }
}
